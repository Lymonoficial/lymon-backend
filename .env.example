MONGODB_URI = YOUR_MONGODB_CONNECTION_STRING
JWT_SECRET = your_jwt_secret_key
APP_URL=YOUR_APP_URL

# Cloudflare R2 Storage
R2_ACCOUNT_ID=accountid
R2_ACCESS_KEY_ID=accesskey
R2_SECRET_ACCESS_KEY=secretaccesskey
R2_BUCKET_NAME=bucket_name
R2_PUBLIC_URL=https://your-r2-public-url
# Separate bucket for guest documents (IDs, passports). MUST have public access
# disabled — reads go through short-lived presigned GET URLs, never a public URL.
R2_DOCUMENTS_BUCKET_NAME=guest_documents_bucket_name

# Email webhook (Brevo)
EMAIL_INBOUND_ENABLED=false
EMAIL_WEBHOOK_SECRET=