{
  "name": "lymon-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:cov:scope": "jest --coverage --coverageDirectory=coverage/scope --testPathPatterns=\"test/(application/(auth/login|property/(create-property|get-properties-by-tenant)|tenant/register-tenant|user/verify-email)|domain/user)\"",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "sonar": "npm run test:cov:scope && sonar-scanner"
  },
  "dependencies": {
    "@getbrevo/brevo": "^4.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/event-emitter": "^3.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/swagger": "^11.2.5",
    "@types/nodemailer": "^6.4.14",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "mongodb": "^7.0.0",
    "mongoose": "^9.1.5",
    "nodemailer": "^6.9.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-dist": "^5.31.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.7",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": ".",
    "roots": ["<rootDir>/src", "<rootDir>/test"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": ["ts-jest", {
        "tsconfig": "tsconfig.jest.json"
      }]
    },
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1",
      "^@test/(.*)$": "<rootDir>/test/$1"
    },
    "collectCoverageFrom": [
      "src/application/auth/commands/login.command.ts",
      "src/application/auth/commands/login.handler.ts",
      "src/application/auth/services/jwt.service.ts",
      "src/application/auth/services/password-hasher.service.ts",
      "src/application/property/commands/create-property.command.ts",
      "src/application/property/commands/create-property.handler.ts",
      "src/application/property/commands/create-property.result.ts",
      "src/application/property/queries/GetPropertiesByTenant/get-properties-by-tenant.query.ts",
      "src/application/property/queries/GetPropertiesByTenant/get-properties-by-tenant.query-handler.ts",
      "src/application/property/queries/GetPropertiesByTenant/get-properties-by-tenant.result.ts",
      "src/application/shared/services/email.service.ts",
      "src/application/tenant/commands/register-tenant.command.ts",
      "src/application/tenant/commands/register-tenant.handler.ts",
      "src/application/user/commands/verify-email/verify-email.command.ts",
      "src/application/user/commands/verify-email/verify-email.handler.ts",
      "src/domain/audit/entities/audit-log.entity.ts",
      "src/domain/audit/repositories/audit-log.repository.ts",
      "src/domain/audit/value-objects/audit-action.vo.ts",
      "src/domain/property/entities/property.entity.ts",
      "src/domain/property/repositories/property.repository.ts",
      "src/domain/property/value-objects/cancellation-policy.vo.ts",
      "src/domain/property/value-objects/location.vo.ts",
      "src/domain/property/value-objects/property-id.vo.ts",
      "src/domain/property/value-objects/property-type.vo.ts",
      "src/domain/role/entities/role.entity.ts",
      "src/domain/role/repositories/role.repository.ts",
      "src/domain/role/value-objects/permission.vo.ts",
      "src/domain/shared/exceptions/domain.exception.ts",
      "src/domain/shared/transaction-manager.interface.ts",
      "src/domain/shared/value-objects/email.vo.ts",
      "src/domain/tenant/entities/tenant.entity.ts",
      "src/domain/tenant/repositories/tenant.repository.ts",
      "src/domain/tenant/value-objects/plan-type.vo.ts",
      "src/domain/tenant/value-objects/tenant-id.vo.ts",
      "src/domain/unit/entities/unit.entity.ts",
      "src/domain/unit/repositories/unit.repository.ts",
      "src/domain/unit/value-objects/bed-type.vo.ts",
      "src/domain/unit/value-objects/external-ids.vo.ts",
      "src/domain/unit/value-objects/unit-id.vo.ts",
      "src/domain/user/entities/user.entity.ts",
      "src/domain/user/repositories/user.repository.ts",
      "src/infrastructure/audit/events/audit-logged.event.ts",
      "src/infrastructure/audit/listeners/audit-event.listener.ts"
    ],
    "coverageDirectory": "./coverage",
    "coverageReporters": ["lcov", "text", "text-summary"],
    "testEnvironment": "node"
  }
}
